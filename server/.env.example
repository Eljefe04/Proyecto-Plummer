# Copiar este archivo como ".env" (sin el ".example") y completar con
# los datos reales. El archivo ".env" NUNCA se sube a git ni se comparte.

# Cadena de conexion a la base de datos PostgreSQL (Neon).
# Se consigue en el panel de Neon: Dashboard -> tu proyecto -> Connection string.
DATABASE_URL=postgresql://usuario:password@host/basededatos?sslmode=require

# Puerto en el que corre el servidor (Render lo define solo en produccion,
# esta linea es solo para correrlo en tu PC).
PORT=3001
